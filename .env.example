# =====================================================================
# DIY-STRM 环境变量配置模板
# 用法：
#   1. 复制为 config/.env（Docker 挂载目录内）或 docker compose env_file
#   2. 修改需要覆盖的项，重启容器生效
# 优先级：环境变量 / config/.env > config/config.yaml > 内置默认值
# 留空或未设置的变量不覆盖 config.yaml 中的对应值
# =====================================================================

# ---------- 数据库（默认不设 = 内嵌 PostgreSQL 单容器模式） ----------
## 数据库引擎：postgres（默认）或 sqlite
# DB_ENGINE=postgres
## SQLite 数据库文件路径（engine=sqlite 时生效）
# DB_SQLITE_FILE=qmediasync.db
## PostgreSQL 类型：embedded（内嵌，默认，单容器无需外部依赖）或 external（外部数据库）
# DB_POSTGRES_TYPE=embedded
## 外部 PostgreSQL 连接信息（embedded 模式不需要）
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=qms
# DB_PASSWORD=qms123456
# DB_NAME=qms
# DB_SSLMODE=disable
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=25

# ---------- Web 服务 ----------
## HTTP/HTTPS 监听地址（默认 :12333 / :12332）
# HTTP_HOST=:12333
# HTTPS_HOST=:12332
## JWT 密钥；留空时自动生成强随机密钥并写回 config.yaml
# JWT_SECRET=
## 数据库缓存大小（字节）
# CACHE_SIZE=20971520
## 允许携带浏览器登录凭证的跨源前端来源，逗号分隔
# TRUSTED_ORIGINS=

# ---------- STRM 生成 ----------
## 视频扩展名（逗号分隔，不带点）
# STRM_VIDEO_EXT=mp4,mkv,avi,mov,wmv,flv,webm,m4v,3gp,ts
## 元数据/字幕扩展名（逗号分隔，不带点）
# STRM_META_EXT=jpg,jpeg,png,webp,nfo,srt,ass,svg,sup,lrc
## 最小视频大小（MB），低于此值不生成 STRM
# STRM_MIN_VIDEO_SIZE=100
## STRM 定时同步 cron 表达式（默认每小时 30 分）
# STRM_CRON=30 * * * *

# ---------- 日志 ----------
# LOG_LEVEL=info
# LOG_MAX_SIZE_MB=10
# LOG_MAX_BACKUPS=3
# LOG_MAX_AGE_DAYS=7

# ---------- 第三方密钥 ----------
## TMDB / fanart.tv / OpenAI 兼容 API Key；Web 设置页配置优先于环境变量
# TMDB_API_KEY=
# TMDB_ACCESS_TOKEN=
# FANART_API_KEY=
# SC_API_KEY=
## OAuth 中转共享 AES 密钥（网盘 OAuth 中转场景）
# OAUTH_RELAY_ENCRYPTION_KEY=

# ---------- 其他 ----------
## 首次启动（无 config.yaml）默认直接用内嵌 PostgreSQL 启动；设为 1 时改用旧式 Web 配置向导
# QMS_SETUP_WIZARD=0
## 认证服务地址（一般无需修改）
# AUTH_SERVER=https://api.mqfamily.top
# NEW_AUTH_SERVER=https://oauth.qmediasync.cn
## 百度网盘 APP ID（一般无需修改）
# BAIDUPAN_APP_ID=QMediaSync
## Emby 302 代理出站 HTTPS 跳过证书校验（true/false；仅内网自签名证书排障时开启）
# EMBY302_INSECURE_SKIP_VERIFY=false
